# PURPLE AI — własny serwer modelu (purple_model_api.py)
# W hostingu ustaw PURPLE_API_KEY jako długi, losowy sekret.
# Nigdy nie commituj prawdziwych kluczy API do GitHuba.
PURPLE_API_KEY=ustaw_tutaj_wlasny_dlugi_sekret
MODEL_ID=Qwen/Qwen2.5-3B-Instruct
MAX_NEW_TOKENS=768
# Opcjonalnie: Tavily do wyszukiwania aktualnych informacji
SEARCH_API_KEY=

# OPCJONALNIE — stary demonstracyjny interfejs Node.js (server.js).
# To NIE jest potrzebne do uruchomienia własnego modelu w purple_model_api.py.
# Ustaw te wartości tylko wtedy, gdy świadomie używasz interfejsu Node
# z zewnętrznym dostawcą zgodnym z API OpenAI.
API_BASE_URL=
API_KEY=
MODEL_NAME=
